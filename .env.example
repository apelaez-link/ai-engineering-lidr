# ─────────────────────────────────────────────────────────────
# Plantilla de variables de entorno.
# Copia este archivo a .env y rellena tus valores reales:
#   cp .env.example .env
# El .env real NUNCA se sube al repo (está en .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Proveedores y fallback ───────────────────────────────────
# Proveedor preferido (compatibilidad con la sesión 02).
LLM_PROVIDER=openai

# Orden de fallback: el wrapper intenta el primero; si falla, rota al siguiente.
# Solo se usan los proveedores que tengan API key rellenada más abajo.
PROVIDER_FALLBACK_ORDER=openai,anthropic

# Claves de API (rellena al menos una; las dos para probar el fallback de verdad)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos económicos recomendados para el ejercicio
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5

# Parámetros de generación
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1500

# ── Memoria conversacional (sesión 05) ───────────────────────
# Tamaño de la ventana deslizante del historial, en pares user+assistant.
MAX_HISTORY_TURNS=6
# Modelo del extractor de metadatos del proyecto (segundo LLM, vía Instructor).
METADATA_EXTRACTOR_MODEL=gpt-4o-mini

# ── Cacheo (sesión 03) ───────────────────────────────────────
CACHE_ENABLED=true
# "memory" (por defecto, sin infra) o "redis"
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=86400
# Solo se usa si CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0

# ── Observabilidad / logging (sesión 03) ─────────────────────
# "development" -> consola legible | "production" -> JSON
ENV=development
LOG_LEVEL=INFO

# ── Persistencia vectorial (sesión 08) ───────────────────────
# Postgres + pgvector. En local (uv) apunta a localhost:5433 (docker compose up -d postgres).
# En docker-compose.prod.yml el host es el servicio `postgres` (lo define el propio compose).
DATABASE_URL=postgresql+asyncpg://estimator:estimator@localhost:5433/estimator

# ── Capa de agentes (sesión 12) ──────────────────────────────
# Modelo del agente: gpt-5 (enunciado) o gpt-4o si no tienes acceso a gpt-5.
AGENT_MODEL=gpt-5
AGENT_REASONING_EFFORT=medium
AGENT_MAX_STEPS=8
AGENT_SEARCH_K=5

# ── Orquestación con LangGraph (sesión 13) ───────────────────
GRAPH_CHECKPOINTER_ENABLED=true
# DSN psycopg (postgresql://, NO +asyncpg) del checkpointer. En prod: host `postgres`.
GRAPH_CHECKPOINTER_URL=postgresql://estimator:estimator@localhost:5433/estimator
# Observabilidad del grafo. Rellena LOGFIRE_TOKEN para exportar a la nube de Logfire.
LOGFIRE_ENABLED=true
# LOGFIRE_TOKEN=

# ── Sistema multi-agente (sesión 14) ─────────────────────────
# Horas por encima de las cuales la estimación exige revisión humana (HITL).
MULTIAGENT_REVIEW_THRESHOLD_HOURS=300

# ── Despliegue / puesta en producción (sesión 15) ────────────
# Token de servicio entre el gateway y el servicio IA. VACÍO en local (auth desactivada);
# OBLIGATORIO en docker-compose.prod.yml. Genera uno con: openssl rand -hex 32
AI_SERVICE_TOKEN=
